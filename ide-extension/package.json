{
  "name": "antigravity-mobile-bridge",
  "displayName": "Antigravity Mobile Remote",
  "description": "Control your Antigravity IDE AI Chat Sidebar from your phone with Chat Auto-Crop, Agent Done chime/vibration alerts, Voice-to-Prompt, 1-tap IDE window switching, and zero-setup encrypted QR pairing.",
  "version": "2.0.0",
  "publisher": "mohammed-nihal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/iamnih4l/antigravity-mobile.git"
  },
  "homepage": "https://antigravity-mobile-zeta.vercel.app",
  "categories": [
    "Other"
  ],
  "keywords": [
    "antigravity",
    "mobile",
    "ai",
    "remote",
    "ide",
    "qr",
    "chat"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "build": "tsc -p ./"
  },
  "contributes": {
    "commands": [
      {
        "command": "antigravityMobile.pairDevice",
        "title": "Antigravity Mobile: Show Mobile QR Code"
      },
      {
        "command": "antigravityMobile.setPwaUrl",
        "title": "Antigravity Mobile: Set Custom Web App URL"
      },
      {
        "command": "antigravityMobile.restartTunnel",
        "title": "Antigravity Mobile: Restart Cloudflare Tunnel"
      },
      {
        "command": "antigravityMobile.syncModels",
        "title": "Antigravity Mobile: Sync Available IDE Models"
      },
      {
        "command": "antigravityMobile.connectionStatus",
        "title": "Antigravity Mobile: Show Companion Service Status"
      }
    ],
    "configuration": {
      "title": "Antigravity Mobile",
      "properties": {
        "antigravityMobile.companionUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8787",
          "description": "Local Loopback URL for the Antigravity Mobile Companion Service"
        },
        "antigravityMobile.pwaUrl": {
          "type": "string",
          "default": "https://antigravity-mobile-zeta.vercel.app",
          "description": "Web App URL opened when scanning the QR code (defaults to the hosted stateless PWA; change if self-hosting)"
        },
        "antigravityMobile.autoStartTunnel": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start Cloudflare Quick Tunnel when Antigravity IDE opens"
        },
        "antigravityMobile.companionScriptPath": {
          "type": "string",
          "default": "",
          "description": "Optional override path to companion-service/src/server.mjs"
        }
      }
    }
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6"
  }
}
